<Window x:Class="mamaRabota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mamaRabota"
        mc:Ignorable="d"
        Title="Автозаполнение путевых листов" Height="764" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- Стили для TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D9E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#7BA7D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для Label заголовков -->
        <Style x:Key="HeaderLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для обычных Label -->
        <Style x:Key="NormalLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5A6C7D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для GroupBox -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="10" 
                                    Margin="0,10,0,0"/>
                            <Border Background="#4A90E2" 
                                    CornerRadius="6" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top" 
                                    Margin="12,0,0,0" 
                                    Padding="10,3">
                                <ContentPresenter ContentSource="Header" 
                                                  TextElement.Foreground="White" 
                                                  TextElement.FontSize="12" 
                                                  TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для RadioButton -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D9E6"/>
        </Style>

        <!-- Стиль для главной кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#357ABD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A5F9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                
                CornerRadius="10" 
                Padding="20,14" 
                Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4A90E2" Offset="0"/>
                    <GradientStop Color="#357ABD" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Автозаполнение путевых листов" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Левая колонка: Основные данные -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Основные данные" Style="{StaticResource ModernGroupBox}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="Сумма за все дни:" Style="{StaticResource HeaderLabel}" Width="130"/>
                        <TextBox x:Name="fullSumtxt" Width="80" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="Литры за все дни:" Style="{StaticResource HeaderLabel}" Width="130"/>
                        <TextBox x:Name="fullLitrstxt" Width="80" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="№ путевого листа:" Style="{StaticResource HeaderLabel}" Width="130"/>
                        <TextBox x:Name="txtNPutList" Width="60" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="-" Style="{StaticResource NormalLabel}" Margin="6,0"/>
                        <TextBox x:Name="txtTireN" Width="50" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Label Content="Сезон:" Style="{StaticResource HeaderLabel}" Width="130"/>
                        <Label Content="❄ Зима" Style="{StaticResource NormalLabel}"/>
                        <RadioButton GroupName="seasons" x:Name="rbWinter" Checked="rbWinter_Checked" Style="{StaticResource ModernRadioButton}"/>
                        <Label Content="☀ Лето" Style="{StaticResource NormalLabel}" Margin="10,0,0,0"/>
                        <RadioButton GroupName="seasons" x:Name="rbSummer" Checked="rbSummer_Checked" Style="{StaticResource ModernRadioButton}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Правая колонка: Месяц и дни -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Период" Style="{StaticResource ModernGroupBox}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="Месяц:" Style="{StaticResource HeaderLabel}" Width="70"/>
                        <ComboBox Name="cmbMonth" Width="160" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem>Январь</ComboBoxItem>
                            <ComboBoxItem>Февраль</ComboBoxItem>
                            <ComboBoxItem>Март</ComboBoxItem>
                            <ComboBoxItem>Апрель</ComboBoxItem>
                            <ComboBoxItem>Май</ComboBoxItem>
                            <ComboBoxItem>Июнь</ComboBoxItem>
                            <ComboBoxItem>Июль</ComboBoxItem>
                            <ComboBoxItem>Август</ComboBoxItem>
                            <ComboBoxItem>Сентябрь</ComboBoxItem>
                            <ComboBoxItem>Октябрь</ComboBoxItem>
                            <ComboBoxItem>Ноябрь</ComboBoxItem>
                            <ComboBoxItem>Декабрь</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <Label Content="Рабочие дни:" Style="{StaticResource HeaderLabel}" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <CheckBox x:Name="chekBox1" Style="{StaticResource ModernCheckBox}">01</CheckBox>
                            <CheckBox x:Name="chekBox2" Style="{StaticResource ModernCheckBox}">02</CheckBox>
                            <CheckBox x:Name="chekBox3" Style="{StaticResource ModernCheckBox}">03</CheckBox>
                            <CheckBox x:Name="chekBox4" Style="{StaticResource ModernCheckBox}">04</CheckBox>
                            <CheckBox x:Name="chekBox5" Style="{StaticResource ModernCheckBox}">05</CheckBox>
                            <CheckBox x:Name="chekBox6" Style="{StaticResource ModernCheckBox}">06</CheckBox>
                            <CheckBox x:Name="chekBox7" Style="{StaticResource ModernCheckBox}">07</CheckBox>
                            <CheckBox x:Name="chekBox8" Style="{StaticResource ModernCheckBox}">08</CheckBox>
                        </StackPanel>
                        <StackPanel Margin="12,0">
                            <CheckBox x:Name="chekBox9" Style="{StaticResource ModernCheckBox}">09</CheckBox>
                            <CheckBox x:Name="chekBox10" Style="{StaticResource ModernCheckBox}">10</CheckBox>
                            <CheckBox x:Name="chekBox11" Style="{StaticResource ModernCheckBox}">11</CheckBox>
                            <CheckBox x:Name="chekBox12" Style="{StaticResource ModernCheckBox}">12</CheckBox>
                            <CheckBox x:Name="chekBox13" Style="{StaticResource ModernCheckBox}">13</CheckBox>
                            <CheckBox x:Name="chekBox14" Style="{StaticResource ModernCheckBox}">14</CheckBox>
                            <CheckBox x:Name="chekBox15" Style="{StaticResource ModernCheckBox}">15</CheckBox>
                            <CheckBox x:Name="chekBox16" Style="{StaticResource ModernCheckBox}">16</CheckBox>
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="chekBox17" Style="{StaticResource ModernCheckBox}">17</CheckBox>
                            <CheckBox x:Name="chekBox18" Style="{StaticResource ModernCheckBox}">18</CheckBox>
                            <CheckBox x:Name="chekBox19" Style="{StaticResource ModernCheckBox}">19</CheckBox>
                            <CheckBox x:Name="chekBox20" Style="{StaticResource ModernCheckBox}">20</CheckBox>
                            <CheckBox x:Name="chekBox21" Style="{StaticResource ModernCheckBox}">21</CheckBox>
                            <CheckBox x:Name="chekBox22" Style="{StaticResource ModernCheckBox}">22</CheckBox>
                            <CheckBox x:Name="chekBox23" Style="{StaticResource ModernCheckBox}">23</CheckBox>
                            <CheckBox x:Name="chekBox24" Style="{StaticResource ModernCheckBox}">24</CheckBox>
                        </StackPanel>
                        <StackPanel Margin="12,0">
                            <CheckBox x:Name="chekBox25" Style="{StaticResource ModernCheckBox}">25</CheckBox>
                            <CheckBox x:Name="chekBox26" Style="{StaticResource ModernCheckBox}">26</CheckBox>
                            <CheckBox x:Name="chekBox27" Style="{StaticResource ModernCheckBox}">27</CheckBox>
                            <CheckBox x:Name="chekBox28" Style="{StaticResource ModernCheckBox}">28</CheckBox>
                            <CheckBox x:Name="chekBox29" Style="{StaticResource ModernCheckBox}">29</CheckBox>
                            <CheckBox x:Name="chekBox30" Style="{StaticResource ModernCheckBox}">30</CheckBox>
                            <CheckBox x:Name="chekBox31" Style="{StaticResource ModernCheckBox}">31</CheckBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Нижняя секция: Дни заправки -->
            <!-- Нижняя секция: Дни заправки -->
            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Дни заправки и литры" Style="{StaticResource ModernGroupBox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Столбик 1 -->
                    <StackPanel Grid.Column="0" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs1" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Конечный остаток" Style="{StaticResource HeaderLabel}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" Width="106"/>
                        <TextBox x:Name="txtTarget" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Столбик 2 -->
                    <StackPanel Grid.Column="1" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay2" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs2" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Столбик 3 -->
                    <StackPanel Grid.Column="2" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay3" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs3" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Столбик 4 -->
                    <StackPanel Grid.Column="3" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay4" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs4" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Столбик 5 -->
                    <StackPanel Grid.Column="4" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay5" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs5" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Столбик 6 -->
                    <StackPanel Grid.Column="5" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay6" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs6" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay7" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs7" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="7" Margin="6">
                        <Label Content="День" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtDay8" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                        <Label Content="Литры" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtLitrs8" Margin="0,2" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Кнопка -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="10" 
                Padding="16" 
                Margin="0,12,0,0" 
                BorderBrush="#E1E8ED" 
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="💡 Заполните все поля и нажмите кнопку" 
                           Foreground="#7F8C8D" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,16,0"/>
                <Button x:Name="upLoadBtn" 
                        Content="🚀 Загрузить файл" 
                        Width="180" 
                        Height="44" 
                        Click="upLoadBtn_Click" 
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>